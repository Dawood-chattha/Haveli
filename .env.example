# =============================================================================
# .env.example — the shape of the configuration, and none of its values
# -----------------------------------------------------------------------------
# THIS FILE IS COMMITTED. .env.local IS NOT.
#
# Copy it and fill in the copy:
#
#     cp .env.example .env.local
#
# .gitignore already excludes .env and .env.* while keeping this one file, so
# a filled-in copy cannot be committed by accident. Verify at any time with:
#
#     git check-ignore -v .env.local
#
# Every value below is a placeholder. Nothing here is, or may become, a real
# credential — this file exists so that a new machine knows WHICH variables
# are needed, never WHAT they are.
#
# WHERE THE REAL VALUES COME FROM
# The Supabase dashboard, under Project Settings -> API.
#
# WHERE THE REAL VALUES GO IN PRODUCTION
# The Vercel dashboard, under Settings -> Environment Variables. Not into a
# file, not into the repository, and not into a chat window.
# =============================================================================


# --- Supabase: the project ---------------------------------------------------
# The project's REST endpoint. Not a secret, but still configuration: it names
# which database this deployment talks to, and staging must never be pointed at
# production by a value hard-coded in source.

SUPABASE_URL=https://your-project-ref.supabase.co


# --- Supabase: the anon key --------------------------------------------------
# Safe for a browser to hold. It grants nothing on its own: every request made
# with it is still judged by Row Level Security, so it can only reach what the
# policies allow. If no policy allows something, this key cannot do it.
#
# "Safe in a browser" is not "unimportant". It is still configuration, and it
# still belongs in an environment variable rather than in a source file.

SUPABASE_ANON_KEY=paste-the-anon-public-key-here


# --- Supabase: the service role key ------------------------------------------
# !! SERVER ONLY. THE MOST DANGEROUS VALUE IN THIS PROJECT. !!
#
# This key BYPASSES Row Level Security entirely. It is the whole database with
# no questions asked: every order, every customer, every address, readable and
# writable, by anyone who holds it.
#
# It must never appear in:
#   - any file under assets/ or data/
#   - any HTML page
#   - any response body
#   - any log line or error message
#   - any screenshot, any chat, any commit
#
# If it is ever exposed, treat it as compromised even if it was only visible
# for a moment: rotate it in the Supabase dashboard immediately. A key that has
# been published once cannot be un-published by deleting the file.

SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here


# --- Optional: browser origins allowed to call this API ----------------------
# Leave UNSET in production. The storefront, the admin panel and these
# functions are all served from one domain on Vercel, so no CORS headers are
# needed and none are sent.
#
# Set it only while running the two dev servers on different ports. Never a
# wildcard: there is no code path in respond.js that produces one, because a
# wildcard with credentials lets any page on the internet make calls on behalf
# of a signed-in viewer.
#
# ALLOWED_ORIGINS=http://localhost:8123


# --- Optional: log verbosity -------------------------------------------------
# debug | info | error        (default: info)
#
# LOG_LEVEL=debug
