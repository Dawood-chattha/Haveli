{
  "name": "haveli",
  "version": "1.0.0",
  "private": true,
  "description": "HAVELI storefront and owner panel. The site itself is dependency-free static HTML/CSS/JS; this manifest exists only for the serverless functions under api/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vercel dev --listen 3000",
    "check": "node scripts/check-syntax.mjs",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed.mjs --demo",
    "seed:demo:remove": "node --env-file=.env.local scripts/seed.mjs --remove-demo",
    "seed:dry": "node scripts/seed.mjs --dry",
    "verify:db": "node --env-file=.env.local scripts/verify-db.mjs",
    "static": "powershell -ExecutionPolicy Bypass -File dev/serve.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0"
  },
  "devDependencies": {
    "vercel": "^48.0.0"
  }
}
